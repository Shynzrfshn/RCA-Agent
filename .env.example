# Frontend (copy to .env.local for `npm run dev`; set the same names as
# GitHub repository variables for the Pages deploy).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public half of the VAPID key pair (VAPID_PUBLIC_KEY in supabase/functions/.env)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
